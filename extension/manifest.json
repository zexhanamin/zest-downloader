{
  "manifest_version": 3,
  "name": "Zest Downloader",
  "version": "1.0.0",
  "description": "Capture downloads and magnet links \u2014 send them to Zest Downloader automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zest Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "cookies",
    "tabs",
    "storage",
    "notifications",
    "contextMenus",
    "alarms",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:6543/*",
    "http://localhost:6543/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Toggle Zest Downloader interception"
    }
  }
}